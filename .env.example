# --------------------------------------------------------------------
# Retail Cube – local development environment
# Copy this file to `.env` and fill in real values.
# Never commit `.env` to source control.
# --------------------------------------------------------------------

# Postgres ------------------------------------------------------------
POSTGRES_DB=retail
POSTGRES_USER=retail
# Generate a strong password: `openssl rand -base64 24`
POSTGRES_PASSWORD=change-me-please
# Bound to 127.0.0.1 in docker-compose; change only if you know why.
POSTGRES_PORT=5432

# Cube ---------------------------------------------------------------
# REST/GraphQL HTTP port (exposed on 127.0.0.1).
CUBE_PORT=4000
# Cube SQL API port (Postgres-wire protocol).
CUBE_SQL_PORT=15432

# Dev mode enables GraphiQL playground and disables JWT enforcement.
# MUST be set to `false` in production.
CUBEJS_DEV_MODE=true

# Used to sign/verify JWTs. Generate with: `openssl rand -hex 32`
CUBEJS_API_SECRET=replace-with-openssl-rand-hex-32

# Optional: log level (error | warn | info | trace)
CUBEJS_LOG_LEVEL=info
